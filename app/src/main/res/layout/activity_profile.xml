<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#744E52"
    tools:context=".Profile">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constraintLayout4"
        android:layout_width="386dp"
        android:layout_height="330dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="3dp"
        android:layout_marginEnd="13dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toTopOf="@+id/textView16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_v_profile_username">

        <TextView
            android:id="@+id/textView9"
            android:layout_width="68dp"
            android:layout_height="26dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="302dp"
            android:text="Name:"
            android:textColor="#f7e8ca"
            android:textSize="20sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_v_profile_lname"
            android:layout_width="172dp"
            android:layout_height="29dp"
            android:layout_marginStart="2dp"
            android:layout_marginTop="42dp"
            android:text="Lname"
            android:textColor="#f7e8ca"
            android:textSize="20sp"
            app:layout_constraintStart_toEndOf="@+id/tv_v_profile_fname"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_v_profile_fname"
            android:layout_width="180dp"
            android:layout_height="26dp"
            android:layout_marginStart="16dp"
            android:text="Fname"
            android:textColor="#f7e8ca"
            android:textSize="20sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textView9" />

        <TextView
            android:id="@+id/tv_v_profile_email"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Email"
            android:textColor="#f7e8ca"
            android:textSize="20sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textView7" />

        <TextView

            android:id="@+id/textView12"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="26dp"
            android:layout_marginEnd="247dp"
            android:text="Match Points:"
            android:textColor="#f7e8ca"
            android:textSize="20sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_v_profile_email" />

        <TextView

            android:id="@+id/tv_v_profile_points"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Points"
            android:textColor="#f7e8ca"
            android:textSize="20sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textView12" />

        <TextView
            android:id="@+id/textView14"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="26dp"
            android:layout_marginEnd="145dp"
            android:text="Average Time Per Match:"
            android:textColor="#f7e8ca"
            android:textSize="20sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_v_profile_points" />

        <TextView
            android:id="@+id/tv_v_profile_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Time"
            android:textColor="#f7e8ca"
            android:textSize="20sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textView14" />

        <TextView
            android:id="@+id/textView7"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="28dp"
            android:layout_marginEnd="315dp"
            android:text="Email:"
            android:textColor="#f7e8ca"
            android:textSize="20sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_v_profile_fname" />

    </androidx.constraintlayout.widget.ConstraintLayout>


    <TextView
        android:id="@+id/tv_v_profile_username"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="127dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="128dp"
        android:text="Username"
        android:textColor="#f7e8ca"
        android:textSize="34sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textView16"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="142dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="143dp"
        android:text="Match History"
        android:textColor="#f7e8ca"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/constraintLayout4" />

    <ListView
        android:id="@+id/lv_v_profile_matchHistory"
        android:layout_width="411dp"
        android:layout_height="240dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView16">

    </ListView>

    <Button
        android:id="@+id/btn_v_profile_back"
        android:layout_width="124dp"
        android:layout_height="60dp"
        android:layout_marginStart="4dp"
        android:layout_marginTop="3dp"
        android:backgroundTint="#482B2E"
        android:text="Back"
        android:textColor="#f7e8ca"
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/lv_v_profile_matchHistory" />

    <Button
        android:id="@+id/btn_v_profile_delete"
        android:layout_width="124dp"
        android:layout_height="60dp"
        android:layout_marginStart="15dp"
        android:layout_marginTop="3dp"
        android:layout_marginEnd="15dp"
        android:backgroundTint="#482B2E"
        android:text="Delete Account"
        android:textColor="#f7e8ca"
        android:textSize="16sp"
        app:layout_constraintEnd_toStartOf="@+id/btn_v_profile_update"
        app:layout_constraintStart_toEndOf="@+id/btn_v_profile_back"
        app:layout_constraintTop_toBottomOf="@+id/lv_v_profile_matchHistory" />

    <Button
        android:id="@+id/btn_v_profile_update"
        android:layout_width="124dp"
        android:layout_height="60dp"
        android:layout_marginTop="3dp"
        android:layout_marginEnd="5dp"
        android:backgroundTint="#482B2E"
        android:text="Update Account"
        android:textColor="#f7e8ca"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/lv_v_profile_matchHistory" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cons_v_profile_alert"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66482B2E"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="invisible">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="296dp"
            android:layout_height="249dp"
            android:background="#f7e8ca"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/textView25"
                android:layout_width="231dp"
                android:layout_height="42dp"
                android:layout_marginTop="11dp"
                android:text="Are you sure you want to delete your account?"
                android:textAlignment="center"
                android:textColor="#744E52"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <Button
                android:id="@+id/btn_v_profile_yes"
                android:layout_width="118dp"
                android:layout_height="73dp"
                android:layout_marginEnd="7dp"
                android:layout_marginBottom="5dp"
                android:backgroundTint="#482B2E"
                android:text="Yes"
                android:textColor="#f7e8ca"
                android:textSize="24sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <Button
                android:id="@+id/btn_v_profile_no"
                android:layout_width="118dp"
                android:layout_height="73dp"
                android:layout_marginStart="7dp"
                android:layout_marginBottom="5dp"
                android:backgroundTint="#482B2E"
                android:text="No"
                android:textColor="#f7e8ca"
                android:textSize="24sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>